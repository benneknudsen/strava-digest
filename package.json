{
  "name": "strava-digest",
  "version": "0.1.0",
  "description": "Turns a Strava bulk export into one compact training digest an agent can read: splits, HR drift, pace consistency, zones, training load, trends.",
  "scripts": {
    "test": "node scripts/smoke-test.mjs",
    "start": "node src/cli.ts",
    "typecheck": "tsc --noEmit",
    "measure": "node scripts/measure-compression.mjs"
  },
  "keywords": [
    "strava",
    "running",
    "training",
    "digest",
    "llm",
    "agent",
    "fit",
    "gpx"
  ],
  "author": "Benjamin Knudsen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/benneknudsen/strava-digest.git"
  },
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "fit-file-parser": "^6.2.2",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/yauzl": "^3.4.0",
    "typescript": "^7.0.2"
  },
  "bin": {
    "strava-digest": "src/cli.ts"
  },
  "private": true,
  "engines": {
    "node": ">=22.18"
  }
}
